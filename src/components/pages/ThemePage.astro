---
import { t } from "../../i18n/ui";
import { contrast } from "../../lib/color";
import { contrastRatio, generatedDescription, terminalThemeDescription } from "../../lib/data";
import { ansiPairs } from "../../lib/palette";
import { ports, type PortTarget } from "../../lib/ports";
import { agentPrompt, installCommand } from "../../lib/ports/install";
import { absoluteFileUrl, absoluteUrl, localizedHref, themePath, type Page } from "../../lib/routes";
import { similarThemes } from "../../lib/similar";
import { terminalThemeFaqs } from "../../lib/terminalThemeFaq";
import Breadcrumbs from "../Breadcrumbs.astro";
import ZoomIcon from "../ZoomIcon.astro";
import ThemeCard from "../ThemeCard.astro";

const page = Astro.props.page as Extract<Page, { kind: "theme" | "themeVariant" }>;
const { theme, locale } = page;
const target = page.kind === "themeVariant" ? page.target : undefined;
const activePort = target ? ports.find((port) => port.slug === target.slug) : undefined;
const activeContent = activePort ? activePort.serialize(theme) : "";
const href = (bare: string) => localizedHref(locale, bare);
const hubHref = localizedHref(locale, themePath(theme));
const variantHref = (slug: string) => localizedHref(locale, `${slug}/themes/${theme.family}/${theme.slug}`);
const ratio = contrastRatio(theme);
const pairs = ansiPairs(theme.palette.ansi);
const paletteJson = JSON.stringify(
  {
    name: theme.name,
    appearance: theme.appearance,
    ...theme.palette,
  },
  null,
  2,
);
const similar = similarThemes(theme, 4);
const faqs = target ? terminalThemeFaqs(theme, target, locale) : [];
const baseColors = [
  { name: t(locale, "common.background"), hex: theme.palette.background },
  { name: t(locale, "common.foreground"), hex: theme.palette.foreground },
  { name: t(locale, "common.cursor"), hex: theme.palette.cursor },
  { name: t(locale, "common.selection"), hex: theme.palette.selectionBackground },
];
const contrastRows = [
  { name: t(locale, "common.foreground"), hex: theme.palette.foreground },
  { name: t(locale, "common.cursor"), hex: theme.palette.cursor },
  { name: t(locale, "common.selection"), hex: theme.palette.selectionBackground },
  ...pairs.map(({ name, hex }) => ({ name, hex })),
];
const ratioClass = (value: number) => (value >= 7 ? "ratio-good" : value >= 4.5 ? "" : value >= 3 ? "ratio-warn" : "ratio-bad");
const portFileName = (port: PortTarget) => `${theme.family}-${theme.slug}.${port.extension}`;
const portPath = (port: PortTarget) => `/ports/${port.slug}/${portFileName(port)}`;
const portUrl = (port: PortTarget) => absoluteFileUrl(portPath(port));
const previewFor = (port: PortTarget) => `/previews/${theme.family}-${theme.slug}-${port.slug}.svg`;
const previewAlt = (port: PortTarget) =>
  locale === "zh" ? `${theme.name} 在 ${port.name} 中的预览` : `${theme.name} preview in ${port.name}`;
const commandFor = (port: PortTarget) => installCommand(port.slug, theme, portUrl(port));
const promptFor = (port: PortTarget) => target ? agentPrompt(theme, target, absoluteUrl(page.path), portUrl(port), locale) : "";
const installLabel = (port: PortTarget) =>
  port.slug === "windows-terminal"
    ? "PowerShell"
    : ["alacritty", "iterm2"].includes(port.slug)
      ? t(locale, "common.download")
      : t(locale, "target.oneLineInstall");
const title = target ? `${theme.name} for ${target.name}` : theme.name;
const lede = target ? terminalThemeDescription(theme, target, locale) : generatedDescription(theme, locale);
---

<section class="page-head">
  <div class="wrap">
    <Breadcrumbs page={page} />
    <p class="eyebrow">
      {target && <>{target.name} · </>}{theme.family} · {theme.appearance} · {theme.source.license}
    </p>
    <h1>{title}</h1>
    <p class="lede">{lede}</p>
    <p class="byline small muted">
      {locale === "zh" ? "来源" : "Source"}: {theme.source.author}
      {" · "}{t(locale, "common.updated")} {theme.meta.updatedAt}
      {" · "}{theme.source.license}
      {theme.source.upstream && <>{" · "}<a href={theme.source.upstream} rel="noopener">{locale === "zh" ? "上游项目" : "Upstream"}</a></>}
    </p>
    <div class="actions">
      <a class="btn btn-primary" href={`${href("editor")}?theme=${encodeURIComponent(theme.id)}`}>{t(locale, "common.openInEditor")}</a>
      {target && activePort ? (
        <>
          <button class="btn" data-copy={commandFor(activePort)}>{t(locale, "theme.copyInstall")}</button>
          <a class="btn" href={portPath(activePort)} download>{t(locale, "common.downloadTheme")}</a>
          <a class="btn" href={hubHref}>{locale === "zh" ? "所有终端" : "All terminals"}</a>
        </>
      ) : (
        <>
          <button class="btn" data-copy={paletteJson}>{t(locale, "common.copy")} JSON</button>
          <a class="btn" href="#terminal-previews">{locale === "zh" ? "选择终端" : "Choose a terminal"}</a>
        </>
      )}
    </div>
  </div>
</section>

<div class="wrap">
  <div class="theme-layout">
    <div>
      {target && activePort ? (
        <>
          <h2 class="preview-heading">{locale === "zh" ? "预览" : "Preview"}</h2>
          <div class="theme-preview">
            <button
              class="preview-zoom"
              type="button"
              data-zoom
              aria-label={locale === "zh" ? "查看大图" : "View larger preview"}
            >
              <img
                data-theme-preview
                src={previewFor(activePort)}
                alt={previewAlt(activePort)}
                width="1200"
                height="720"
                loading="eager"
                decoding="async"
              />
              <span class="zoom-chip" aria-hidden="true"><ZoomIcon /></span>
            </button>
          </div>
        </>
      ) : (
        <>
          <h2 class="preview-heading" id="terminal-previews">{locale === "zh" ? "终端预览" : "Terminal previews"}</h2>
          <div class="grid terminal-preview-grid">
            {ports.map((port) => (
              <a class="card" href={variantHref(port.slug)}>
                <div class="card-media">
                  <img
                    src={previewFor(port)}
                    alt={previewAlt(port)}
                    loading="lazy"
                    width="1200"
                    height="720"
                  />
                </div>
                <div class="card-body">
                  <div class="card-title">
                    <span>{port.name}</span>
                    <span class="badge">{port.extension}</span>
                  </div>
                  <p class="muted small">
                    {locale === "zh" ? `打开 ${theme.name} 的 ${port.name} 版本` : `Open ${theme.name} for ${port.name}`}
                  </p>
                </div>
              </a>
            ))}
          </div>
        </>
      )}

      <div class="panel" style="margin-top:18px">
        <div class="panel-title-row">
          <h2 class="panel-title">{t(locale, "common.palette")}</h2>
          <button class="hex-button" data-copy={paletteJson}>{t(locale, "common.copy")}</button>
        </div>
        <h3 class="panel-subtitle">{t(locale, "common.ansi")}</h3>
        <div class="ansi-grid">
          {pairs.map(({ name, hex }) => (
            <div class="ansi-cell">
              <div class="ansi-chip" style={`background:${hex}`}></div>
              <div class="ansi-label">
                <span>{name.replace("bright", "b.")}</span>
                <button class="hex-button" data-copy={hex} title={`Copy ${hex}`}>{hex}</button>
              </div>
            </div>
          ))}
        </div>
        <h3 class="panel-subtitle">{locale === "zh" ? "基础颜色" : "Base colors"}</h3>
        <div class="ansi-grid" style="margin-top:6px">
          {baseColors.map(({ name, hex }) => (
            <div class="ansi-cell">
              <div class="ansi-chip" style={`background:${hex}`}></div>
              <div class="ansi-label">
                <span>{name}</span>
                <button class="hex-button" data-copy={hex} title={`Copy ${hex}`}>{hex}</button>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="panel" style="margin-top:18px">
        <div class="panel-title-row">
          <h2 class="panel-title">{t(locale, "common.contrast")}</h2>
          <span class="muted">WCAG · vs {theme.palette.background}</span>
        </div>
        <div class="table-wrap">
          <table>
            <thead>
              <tr><th>Color</th><th>Hex</th><th>Ratio</th><th>Level</th></tr>
            </thead>
            <tbody>
              {contrastRows.map(({ name, hex }) => {
                const value = contrast(hex, theme.palette.background);
                const level = value >= 7 ? "AAA" : value >= 4.5 ? "AA" : value >= 3 ? "AA large" : "—";
                return (
                  <tr>
                    <td>{name}</td>
                    <td class="mono">{hex}</td>
                    <td class={`mono ${ratioClass(value)}`}>{value.toFixed(2)}:1</td>
                    <td class="mono muted">{level}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </div>

      {target && activePort && (
        <div class="panel" style="margin-top:18px">
          <div class="panel-title-row">
            <h2 class="panel-title">{locale === "zh" ? `安装到 ${target.name}` : `Install for ${target.name}`}</h2>
            <a class="hex-button" href={href(target.slug)}>{t(locale, "target.docs")}</a>
          </div>
          <ol class="install-steps">
            {target.install[locale].map((step) => <li>{step}</li>)}
          </ol>
          <div class="install-command-block">
            <div class="install-command-head">
              <span class="mono small muted">{installLabel(activePort)}</span>
              <span class="mono small muted">{portFileName(activePort)}</span>
            </div>
            <pre class="install-command-code"><code>{commandFor(activePort)}</code></pre>
            <div class="actions install-actions">
              <button class="btn btn-small" data-copy={commandFor(activePort)}>{t(locale, "common.copyCommand")}</button>
              <a class="btn btn-small" href={portPath(activePort)} download>{t(locale, "common.download")}</a>
              <a class="btn btn-small" href={href(target.slug)}>{t(locale, "target.docs")}</a>
            </div>
          </div>
          <details class="config-details">
            <summary>{locale === "zh" ? "完整配置文件" : "Full configuration"}</summary>
            <div class="code-block">
              <pre><code>{activeContent}</code></pre>
              <div class="code-actions">
                <button class="btn btn-small" data-copy={activeContent}>{t(locale, "common.copy")}</button>
                <a class="btn btn-small" href={portPath(activePort)} download>{t(locale, "common.download")}</a>
                <span class="mono small muted" style="margin-left:auto">{portFileName(activePort)}</span>
              </div>
            </div>
          </details>
        </div>
      )}

      {target && activePort && (
        <section class="agent-prompt">
          <div class="panel-title-row">
            <h2 class="panel-title">{locale === "zh" ? "让 Agent 帮我安装" : "Let an agent install it"}</h2>
            <button class="btn btn-small" data-copy={promptFor(activePort)}>
              {locale === "zh" ? "复制提示词" : "Copy prompt"}
            </button>
          </div>
          <p class="small muted">
            {locale === "zh"
              ? `把这段提示词交给编码 Agent。它会读取 ${target.name} 的安装页面、备份配置并只修改这个主题需要的文件。`
              : `Give this prompt to your coding agent. It includes the ${target.name} install page, native file, steps, and safety constraints.`}
          </p>
          <pre><code>{promptFor(activePort)}</code></pre>
          <div class="actions">
            <button class="btn btn-small" data-copy={promptFor(activePort)}>
              {locale === "zh" ? "复制提示词" : "Copy prompt"}
            </button>
          </div>
        </section>
      )}
    </div>

    <aside class="side-stack">
      <div class="panel">
        <h2 class="panel-title">{locale === "zh" ? "主题详情" : "Theme details"}</h2>
        <dl class="kv">
          <dt>{t(locale, "common.family")}</dt><dd><a href={href(`themes/${theme.family}`)}>{theme.family}</a></dd>
          <dt>{t(locale, "common.background")}</dt><dd class="mono">{theme.palette.background}</dd>
          <dt>{t(locale, "common.foreground")}</dt><dd class="mono">{theme.palette.foreground}</dd>
          <dt>{t(locale, "common.cursor")}</dt><dd class="mono">{theme.palette.cursor}</dd>
          <dt>{t(locale, "common.selection")}</dt><dd class="mono">{theme.palette.selectionBackground}</dd>
          <dt>{t(locale, "common.contrast")}</dt><dd class="mono">{ratio.toFixed(2)}:1</dd>
          <dt>{t(locale, "common.updated")}</dt><dd class="mono">{theme.meta.updatedAt}</dd>
        </dl>
      </div>

      <div class="panel">
        <h2 class="panel-title">{t(locale, "common.provenance")}</h2>
        <dl class="kv">
          <dt>{t(locale, "common.author")}</dt><dd>{theme.source.author}</dd>
          <dt>{t(locale, "common.license")}</dt>
          <dd>
            {theme.source.licenseUrl
              ? <a href={theme.source.licenseUrl} rel="noopener">{theme.source.license}</a>
              : theme.source.license}
          </dd>
          {theme.source.upstream && <><dt>Upstream</dt><dd><a href={theme.source.upstream} rel="noopener">{theme.source.upstream}</a></dd></>}
          {theme.source.reference && <><dt>Reference</dt><dd><a href={theme.source.reference} rel="noopener">{theme.source.reference}</a></dd></>}
        </dl>
      </div>

      <div class="panel">
        <h2 class="panel-title">{locale === "zh" ? "其他终端" : "Other terminals"}</h2>
        <div class="terminal-links">
          {ports.map((port) => (
            <a class="terminal-link" href={variantHref(port.slug)} aria-current={target?.slug === port.slug ? "page" : undefined}>
              <span>{port.name}</span>
              <span class="mono small muted">{port.extension}</span>
            </a>
          ))}
        </div>
      </div>
    </aside>
  </div>
</div>

{target && faqs.length > 0 && (
  <section class="section" id="faq">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">FAQ</p>
          <h2>{locale === "zh" ? "常见问题" : "Frequently asked questions"}</h2>
        </div>
      </div>
      <div class="faq">
        {faqs.map((faq) => (
          <details class="faq-item">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>
)}

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t(locale, "common.similar")}</p>
        <h2>{t(locale, "common.similar")}</h2>
      </div>
    </div>
    <div class="grid">
      {similar.map(({ theme: candidate, distance }) => (
        <div>
          <ThemeCard
            theme={candidate}
            locale={locale}
            previewTarget={target?.slug}
            previewName={target?.name}
            variant={Boolean(target)}
          />
          <p class="mono small muted" style="margin-top:6px">ΔE00 {distance.toFixed(1)}</p>
        </div>
      ))}
    </div>
  </div>
</section>
