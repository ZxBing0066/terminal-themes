---
import { t } from "../../i18n/ui";
import { allFamilies, allThemes } from "../../lib/data";
import { localized, type Page } from "../../lib/routes";
import ThemeCard from "../ThemeCard.astro";

const page = Astro.props.page as Extract<Page, { kind: "catalog" }>;
const locale = page.locale;
const themes = allThemes();
const families = allFamilies();
const href = (bare: string) => `/${localized(locale, bare)}${bare ? "/" : ""}`;
---

<section class="page-head">
  <div class="wrap">
    <p class="eyebrow">{t(locale, "catalog.count")}: {themes.length}</p>
    <h1>{t(locale, "catalog.title")}</h1>
    <p class="lede">{t(locale, "catalog.description")}</p>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="filter-bar">
      <div class="chips" data-filters>
        <button class="chip" type="button" data-filter="all" aria-pressed="true">
          {t(locale, "common.all")} <span class="chip-count">{themes.length}</span>
        </button>
        <button class="chip" type="button" data-filter="dark" aria-pressed="false">
          {t(locale, "common.dark")} <span class="chip-count">{themes.filter((theme) => theme.appearance === "dark").length}</span>
        </button>
        <button class="chip" type="button" data-filter="light" aria-pressed="false">
          {t(locale, "common.light")} <span class="chip-count">{themes.filter((theme) => theme.appearance === "light").length}</span>
        </button>
      </div>
      <div class="filter-tools">
        <p class="filter-status small muted" data-filter-status data-label={t(locale, "catalog.count")} aria-live="polite">
          {themes.length} {t(locale, "catalog.count")}
        </p>
        <div class="view-switch" role="group" aria-label={t(locale, "catalog.view")}>
          <button class="view-button" type="button" data-view="grid" aria-pressed="true">{t(locale, "catalog.viewGrid")}</button>
          <button class="view-button" type="button" data-view="list" aria-pressed="false">{t(locale, "catalog.viewList")}</button>
          <button class="view-button" type="button" data-view="large" aria-pressed="false">{t(locale, "catalog.viewLarge")}</button>
        </div>
      </div>
    </div>
    <div class="grid" data-theme-grid data-view="grid" style="margin-top:18px">
      {themes.map((theme) => <ThemeCard theme={theme} locale={locale} />)}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t(locale, "common.family")}</p>
        <h2>{t(locale, "common.family")}</h2>
      </div>
    </div>
    <div class="chips">
      {families.map((family) => <a class="chip" href={href(`themes/${family.id}`)}>{family.name}</a>)}
    </div>
  </div>
</section>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-filter]");
  const cards = document.querySelectorAll<HTMLElement>("[data-theme-grid] [data-appearance]");
  const status = document.querySelector<HTMLElement>("[data-filter-status]");
  const valid = new Set(["all", "dark", "light"]);

  const apply = (filter: string, syncUrl: boolean) => {
    const active = valid.has(filter) ? filter : "all";
    let visible = 0;
    cards.forEach((card) => {
      const show = active === "all" || card.dataset.appearance === active;
      card.hidden = !show;
      if (show) visible += 1;
    });
    buttons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.filter === active));
    });
    if (status) status.textContent = `${visible} ${status.dataset.label ?? ""}`.trim();
    if (syncUrl) {
      const url = new URL(window.location.href);
      if (active === "all") url.searchParams.delete("appearance");
      else url.searchParams.set("appearance", active);
      history.replaceState(null, "", url);
    }
  };

  buttons.forEach((button) => {
    button.addEventListener("click", () => apply(button.dataset.filter ?? "all", true));
  });

  apply(new URLSearchParams(window.location.search).get("appearance") ?? "all", false);

  const grid = document.querySelector<HTMLElement>("[data-theme-grid]");
  const viewButtons = document.querySelectorAll<HTMLButtonElement>(".view-button[data-view]");
  const views = new Set(["grid", "list", "large"]);
  const storedView = (() => {
    try {
      return localStorage.getItem("theme-view");
    } catch {
      return null;
    }
  })();
  const queryView = new URLSearchParams(window.location.search).get("view");
  const initialView = queryView ?? storedView ?? "grid";

  const applyView = (view: string, syncUrl: boolean) => {
    const active = views.has(view) ? view : "grid";
    if (grid) grid.dataset.view = active;
    viewButtons.forEach((button) => {
      button.setAttribute("aria-pressed", String(button.dataset.view === active));
    });
    try {
      localStorage.setItem("theme-view", active);
    } catch {
      /* storage unavailable */
    }
    if (syncUrl) {
      const url = new URL(window.location.href);
      if (active === "grid") url.searchParams.delete("view");
      else url.searchParams.set("view", active);
      history.replaceState(null, "", url);
    }
  };

  viewButtons.forEach((button) => {
    button.addEventListener("click", () => applyView(button.dataset.view ?? "grid", true));
  });

  applyView(initialView, false);
</script>
