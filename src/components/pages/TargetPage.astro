---
import { herdrTokens } from "../../data/herdrTokens";
import { t } from "../../i18n/ui";
import { allThemes, getTheme } from "../../lib/data";
import { deriveHerdrAppColors } from "../../lib/ports/herdr-app";
import { installCommand } from "../../lib/ports/install";
import { portFileName, ports } from "../../lib/ports";
import { absoluteFileUrl, localizedHref, type Page } from "../../lib/routes";
import { SITE_UPDATED } from "../../lib/siteMeta";
import { targetFaqs } from "../../lib/targetFaq";
import Breadcrumbs from "../Breadcrumbs.astro";
import ThemeCard from "../ThemeCard.astro";

const page = Astro.props.page as Extract<Page, { kind: "target" }>;
const { target, locale } = page;
const themes = allThemes();
const href = (bare: string) => localizedHref(locale, bare);
const sample = getTheme("catppuccin", "mocha");
const sampleColors = sample ? deriveHerdrAppColors(sample) : undefined;
const samplePort = ports.find((port) => port.slug === target.slug);
const sampleUrl =
  sample && samplePort
    ? absoluteFileUrl(`/ports/${target.slug}/${portFileName(sample, samplePort)}`)
    : "";
const sampleCommand = sample ? installCommand(target.slug, sample, sampleUrl) : "";
const faqs = targetFaqs(target, locale);
const darkThemes = themes.filter((theme) => theme.appearance === "dark");
const lightThemes = themes.filter((theme) => theme.appearance === "light");
---

<section class="page-head">
  <div class="wrap">
    <Breadcrumbs page={page} />
    <p class="eyebrow">{themes.length} {t(locale, "common.themes")}</p>
    <h1>{target.title[locale]}</h1>
    <p class="lede">{target.description[locale]}</p>
    <div class="chips" style="margin-top:18px">
      {target.docs && <a class="chip" href={target.docs} rel="noopener">{t(locale, "target.docs")}</a>}
      <a class="chip" href={href("themes")}>{t(locale, "nav.themes")}</a>
      <a class="chip" href={href("editor")}>{t(locale, "nav.editor")}</a>
    </div>
    <p class="byline small muted" style="margin-top:14px">
      {locale === "zh" ? "由 Terminal Themes 维护" : "Maintained by Terminal Themes"}
      {" · "}{t(locale, "common.updated")} {SITE_UPDATED}
      {target.docs && <>{" · "}<a href={target.docs} rel="noopener">{t(locale, "target.docs")}</a></>}
      {" · "}<a href={`${href("about")}#verification`}>{locale === "zh" ? "方法" : "Methodology"}</a>
    </p>
  </div>
</section>

<section class="section" style="padding-bottom:0">
  <div class="wrap">
    <article class="prose">
      <h2>{locale === "zh" ? `什么是 ${target.name} 主题？` : `What is a ${target.name} theme?`}</h2>
      <p>
        {locale === "zh"
          ? `要在 ${target.name} 中安装主题，先下载该主题的配置文件，再按下方步骤放到配置目录。本站提供 ${themes.length} 个可直接使用的配色。`
          : `To install a theme in ${target.name}, download the theme file and follow the steps below; this page includes ${themes.length} ready-to-use palettes.`}
      </p>
      <p>
        {locale === "zh"
          ? "每个调色板都设置背景、前景、光标、选区，以及提示符、Git 和编辑器使用的 16 个 ANSI 颜色。同一份数据会导出到每个受支持终端，切换应用时颜色保持一致。"
          : "Each palette sets the background, foreground, cursor, selection, and the 16 ANSI colors used by prompts, Git, and editors. One palette is exported to each supported terminal, so colors stay consistent when you switch apps."}
      </p>
      <h2>{locale === "zh" ? `${target.name} 如何读取主题？` : `How does ${target.name} load themes?`}</h2>
      <p>
        {locale === "zh"
          ? `${target.install.zh[0]} ${target.install.zh[1]} 本站的配置由同一份调色板生成，不复制上游文件或截图。`
          : `${target.install.en[0]} ${target.install.en[1]} This site generates the native file from one palette instead of copying an upstream theme file or screenshot.`}
      </p>
    </article>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t(locale, "target.install")}</p>
        <h2>{t(locale, "target.install")}</h2>
      </div>
    </div>
    <div class="panel">
      <ol class="install-steps">
        {target.install[locale].map((step) => <li>{step}</li>)}
      </ol>
      {sample && (
        <div class="install-command">
          <span class="mono small muted">{target.slug === "windows-terminal" ? "PowerShell" : t(locale, "target.oneLineInstall")}</span>
          <code>{sampleCommand}</code>
          <button class="btn btn-small" data-copy={sampleCommand}>{t(locale, "common.copyCommand")}</button>
        </div>
        <p class="small muted" style="margin:10px 0 0">
          {t(locale, "target.installExample")} <a href={href("themes")}>{t(locale, "target.allThemes")}</a>
        </p>
      )}
    </div>
  </div>
</section>

{target.slug === "herdr-app" && sampleColors && (
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <div>
          <p class="eyebrow">{locale === "zh" ? "主题 token" : "Theme tokens"}</p>
          <h2>{locale === "zh" ? "22 个界面颜色" : "The 22 UI colors"}</h2>
          <p>
            {locale === "zh"
              ? "主题文件先写终端调色板，再可选覆盖界面颜色。下面是 Catppuccin Mocha 的推导结果。"
              : "A theme file writes the terminal palette first, then optionally overrides UI colors. Values below are derived from Catppuccin Mocha."}
          </p>
        </div>
      </div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Token</th><th>{locale === "zh" ? "色块" : "Color"}</th><th>Hex</th><th>{locale === "zh" ? "作用" : "Controls"}</th></tr></thead>
          <tbody>
            {herdrTokens.map(({ token, en, zh }) => {
              const hex = sampleColors[token as keyof typeof sampleColors];
              return (
                <tr>
                  <td class="mono">{token}</td>
                  <td><span class="token-swatch" style={`background:${hex}`} aria-hidden="true"></span></td>
                  <td class="mono">{hex}</td>
                  <td class="muted">{locale === "zh" ? zh : en}</td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </div>
  </section>
)}

<section class="section" id="faq">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">FAQ</p>
        <h2>{locale === "zh" ? "常见问题" : "Frequently asked questions"}</h2>
      </div>
    </div>
    <div class="faq">
      {faqs.map((faq) => (
        <details class="faq-item">
          <summary>{faq.question}</summary>
          <p>{faq.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">{t(locale, "target.allThemes")}</p>
        <h2>{t(locale, "target.allThemes")}</h2>
        <p>
          {locale === "zh"
            ? "以下每个主题都包含完整的 16 色 ANSI 调色板，并已生成该应用的原生配置。"
            : "Every theme below includes the full 16-color ANSI palette and a native configuration for this app."}
        </p>
      </div>
    </div>
    {darkThemes.length > 0 && (
      <>
        <h3 class="panel-subtitle">{t(locale, "common.dark")} · {darkThemes.length}</h3>
        <div class="grid">
          {darkThemes.map((theme) => (
            <ThemeCard theme={theme} locale={locale} previewTarget={target.slug} previewName={target.name} variant />
          ))}
        </div>
      </>
    )}
    {lightThemes.length > 0 && (
      <>
        <h3 class="panel-subtitle">{t(locale, "common.light")} · {lightThemes.length}</h3>
        <div class="grid" style="margin-top:10px">
          {lightThemes.map((theme) => (
            <ThemeCard theme={theme} locale={locale} previewTarget={target.slug} previewName={target.name} variant />
          ))}
        </div>
      </>
    )}
  </div>
</section>
