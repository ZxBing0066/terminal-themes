---
import type { Locale } from "../i18n/ui";
import { ansiList } from "../lib/palette";
import type { Theme } from "../lib/schema";
import ZoomIcon from "./ZoomIcon.astro";

interface Props {
  theme: Theme;
  locale: Locale;
  previewTarget?: string;
  previewName?: string;
}

const { theme, locale, previewTarget = "herdr-app", previewName = "Herdr app" } = Astro.props;
const previewSrc = `/previews/${theme.family}-${theme.slug}-${previewTarget}.svg`;
const href = `/${locale === "zh" ? "zh/" : ""}themes/${theme.family}/${theme.slug}/`;
const colors = ansiList(theme.palette.ansi).slice(0, 8);
---

<div class="card-wrap" data-appearance={theme.appearance}>
  <a class="card" href={href}>
    <div class="card-media">
      <img
        src={previewSrc}
        alt={`${theme.name} preview in ${previewName}`}
        loading="lazy"
        width="1200"
        height="720"
        data-zoom
      />
    </div>
  <div class="card-body">
    <div class="card-title">
      <span>{theme.name}</span>
      <span class="badge">{theme.appearance}</span>
    </div>
    <div class="card-meta">
      <span>{theme.family}</span>
      <span>·</span>
      <span>{theme.source.license}</span>
    </div>
    <div class="swatches" aria-hidden="true">
      {colors.map((color) => <span class="swatch" style={`background:${color}`}></span>)}
    </div>
    </div>
  </a>
  <button
    class="zoom-chip"
    type="button"
    data-zoom
    data-zoom-src={previewSrc}
    data-zoom-alt={`${theme.name} preview in ${previewName}`}
    aria-label={locale === "zh" ? `查看 ${theme.name} 在 ${previewName} 中的大图` : `View larger ${previewName} preview of ${theme.name}`}
  >
    <ZoomIcon />
  </button>
</div>
