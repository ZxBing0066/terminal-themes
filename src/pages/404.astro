---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Not found — Terminal Themes</title>
    <meta name="description" content="The requested page does not exist. Browse the terminal theme catalog or return home." />
    <meta name="robots" content="noindex, follow" />
  </head>
  <body>
    <main class="wrap" style="padding:80px 24px">
      <p class="eyebrow">404</p>
      <h1 style="font-size:48px;margin:12px 0 20px">Not found</h1>
      <p class="lede">That theme or page does not exist.</p>
      <div class="actions">
        <a class="btn btn-primary" href="/themes/">Browse themes</a>
        <a class="btn" href="/">Home</a>
      </div>
    </main>
  </body>
</html>
